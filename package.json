{
  "name": "star-particle-webgl",
  "version": "3.3.0",
  "description": "Four-pointed star with particle gravity for design system hero",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:layout": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=layout",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "screenshot": "npm run build && playwright test tests/e2e/screenshot.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "jest": "^29.7.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@material/web": "^2.4.1"
  }
}
